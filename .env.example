# App
APP_URL=http://127.0.0.1:43123
SESSION_SECRET=replace-with-a-long-random-string
DATABASE_PATH=./data/sales-assistant.db
DEMO_MODE=true
ORG_DOMAIN=turb0.ai

# LLM extraction. heuristic works offline for the demo.
# openai uses any OpenAI-compatible chat endpoint.
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Microsoft 365 / Entra ID. Single tenant for turb0.ai.
# Leave blank to use demo mail. See README for the app registration.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:43123/api/auth/microsoft/callback

# Turb0 Partners (Supabase). Dry-run is the default and sends nothing.
CRM_PROVIDER=local
CRM_DRY_RUN=true
TURB0_SUPABASE_URL=https://itrmlygedcaqjulipxbs.supabase.co
TURB0_SUPABASE_ANON_KEY=
TURB0_AUTH_MODE=user_jwt
TURB0_SERVICE_ROLE_KEY=

# Optional intake
NOTES_WEBHOOK_SECRET=
JOB_SECRET=

# Phase 4. Leave false. Suggest-only will not auto-send even if a user picks that level.
AUTO_SEND_ENABLED=false
